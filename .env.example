# Names only. Provision values privately in each server environment; do not source this as working configuration.
# Backend + engine host only:
# FACTORY_HOST_TOKEN
# Backend only (literal loopback HTTP origin with explicit port):
# FACTORY_HOST_URL
# Web dev/preview server only (never browser configuration):
# FACTORY_BACKEND_URL
# All apps; public non-secret identity and fresh reserved state:
# FACTORY_RUNTIME_CANDIDATE
# FACTORY_RUNTIME_STATE
