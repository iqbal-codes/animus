              "type": "text",
              "id": "Q7IiFf",
              "name": "Scope note",
              "fill": "$xai-text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Source: HPnZs · https://x.ai · 13 October 2026\nCanvas specimens describe appearance. Hover, focus, keyboard handling and disabled behavior must be implemented in code.",
              "lineHeight": 1.5,
              "fontFamily": "$xai-font",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        }
      ]
