              "fill": "$xai-text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Insert instances of the named x.ai components. Override labels, links and imagery in descendants. Use xai-* variables for colors and dimensions. Keep the black canvas, white action hierarchy and source radius scale.",
              "lineHeight": 1.5,
              "fontFamily": "$xai-font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "I6hOUN",
              "name": "Design reasoning",
              "fill": "$xai-text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Black and white reproduce the source contrast. Pill actions distinguish controls from 8 / 12 / 16 px containers. Wide spacing preserves its page rhythm. Product and editorial patterns reuse source artwork rather than invented assets.",
              "lineHeight": 1.5,
              "fontFamily": "$xai-font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
