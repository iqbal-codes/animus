{
  "name": "labq-software-factory",
  "private": true,
  "bin": {
    "factory": "./scripts/cli/cli.ts",
    "labq": "./scripts/cli/cli.ts",
    "labq-factory": "./scripts/cli/cli.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "cli": "bun scripts/cli/cli.ts",
    "build:cli": "bun scripts/release/build-cli.ts",
    "loop": "bun scripts/loop.ts",
    "loop:watch": "bun scripts/loop-watch.ts",
    "scheduler": "bun scripts/scheduler.ts",
    "toolchain": "node scripts/health/check-toolchain.mjs",
    "format": "vp fmt --check apps packages scripts/health scripts/release tests/integration vite.config.ts tsconfig.json tsconfig.tools.json package.json",
    "format:write": "vp fmt --write apps packages scripts/health scripts/release tests/integration vite.config.ts tsconfig.json tsconfig.tools.json package.json",
    "lint": "vp lint --deny-warnings apps packages scripts/health scripts/release tests/integration vite.config.ts",
    "typecheck": "vp check --no-fmt --no-lint",
    "check": "node scripts/health/check-architecture.mjs && bun run format && bun run lint && bun run typecheck",
    "check:architecture": "node scripts/health/check-architecture.mjs",
    "package:release": "bun scripts/release/package.ts",
    "test": "vp run test-all",
    "build:web": "node scripts/health/build-and-inspect.mjs",
    "verify": "vp run verify-all"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@labq/client": "workspace:*",
    "@labq/contracts": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "bun": "1.4.2",
    "node": "26.8.1"
  },
  "packageManager": "bun@1.4.2"
}
