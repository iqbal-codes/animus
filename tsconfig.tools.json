{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "bun"],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "vite.config.ts",
    "apps/web/vite.config.ts",
    "scripts/health/**/*.mjs",
    "scripts/release/**/*.ts",
    "scripts/**/*.ts",
    "scripts/*.ts"
  ]
}
